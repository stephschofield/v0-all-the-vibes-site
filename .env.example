# =============================================================================
# Environment Variables Template
# =============================================================================
# Copy this file to .env.local if you need to add local overrides:
#   cp .env.example .env.local
#
# NEVER commit .env.local or any file with real credentials!
# =============================================================================

# --- Maintainer Application Form (maintainers.md IDE tab) -------------------
# Azure Table Storage for maintainer applications. TWO auth modes — pick one.
#
# PREFERRED: Azure AD via managed identity (no secret to store/rotate). REQUIRED
# on subscriptions where Azure Policy forbids shared-key auth (this one does).
# Set the table endpoint URL; auth resolves via DefaultAzureCredential — the
# Container App's user-assigned identity in prod, or your `az login` creds locally.
#   az storage account create -n <acct> -g <rg> --sku Standard_LRS --kind StorageV2
#   az role assignment create --assignee-object-id <principal> \
#     --assignee-principal-type ServicePrincipal --role "Storage Table Data Contributor" \
#     --scope <storage-account-resource-id>
#   az storage table create -n MaintainerApplications --account-name <acct> --auth-mode login
MAINTAINER_TABLE_ACCOUNT_URL=https://atvmaintainersba7e3331.table.core.windows.net

# FALLBACK: shared-key connection string. Only works on accounts that permit
# shared-key auth (e.g. local Azurite emulator). Ignored if ACCOUNT_URL is set.
MAINTAINER_TABLE_CONNECTION_STRING=

# GitHub org slug backing the repo picker (GET /orgs/{ORG}/repos, public, no token).
# If unset or wrong, the form falls back to a small hardcoded repo list.
GITHUB_ORG=stephschofield

# Optional: webhook (Discord/Teams) notified on each new maintainer application.
# Fire-and-forget; if unset, notification is silently skipped.
MAINTAINER_NOTIFY_WEBHOOK=
